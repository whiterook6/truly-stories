---
import BackLink from './BackLink.astro';
import DownloadButton from './DownloadButton.astro';
import HomeLink from './HomeLink.astro';
import ShareButton from './ShareButton.astro';
import './PageActions.css';

interface Props {
  showHomeButton?: boolean;
  backHref?: string;
  downloadHref?: string;
  shareHref?: string;
}

const {
  showHomeButton,
  backHref,
  downloadHref,
  shareHref,
} = Astro.props as Props;
---
<div class="page-actions" role="group" aria-label="Page actions">
  {showHomeButton && <HomeLink />}
  {backHref && <BackLink href={backHref} />}
  {downloadHref && <DownloadButton href={downloadHref} />}
  {shareHref && <ShareButton href={shareHref} />}
</div>
