---
import Button from "@/components/button/Button.astro";
import LinkButton from "@/components/icon-link-button/IconLinkButton.astro";
import ArrowLeftIcon from "@/components/icons/ArrowLeftIcon.astro";
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import HouseIcon from "@/components/icons/HouseIcon.astro";
import ShareIcon from "@/components/icons/ShareIcon.astro";
import "./PageActions.css";

interface Props {
  showHomeButton?: boolean;
  backHref?: string;
  downloadHref?: string;
  onClickShare?: string;
}

const {
  showHomeButton,
  backHref,
  downloadHref,
  onClickShare,
} = Astro.props as Props;
---

<div class="page-actions" role="group" aria-label="Page actions">
  {
    showHomeButton && (
      <LinkButton href="/">
        <HouseIcon slot="icon" />
        Back to Stories
      </LinkButton>
    )
  }
  {
    backHref && (
      <LinkButton href={backHref}>
        <ArrowLeftIcon slot="icon" />
        Back
      </LinkButton>
    )
  }
  {
    downloadHref && (
      <LinkButton href={downloadHref} download aria-label="Download">
        <DownloadIcon slot="icon" />
      </LinkButton>
    )
  }
  {
    onClickShare && (
      <Button aria-label="Share" onclick={onClickShare}>
        <ShareIcon slot="icon" />
      </Button>
    )
  }
</div>
