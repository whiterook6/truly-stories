---
interface Props {
  href: string;
}

const { href } = Astro.props as Props;
---
<a class="page-action-link" href={href}>
  <span class="page-action-icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      class="lucide lucide-arrow-left-icon lucide-arrow-left" aria-hidden="true">
      <path d="m12 19-7-7 7-7" />
      <path d="M19 12H5" />
    </svg>
  </span>
  <span class="page-action-label">Back</span>
</a>
