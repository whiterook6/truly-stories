---
import Head from '@/components/head/Head.astro';
import PageActions from '@/components/page-actions/PageActions.astro';
import Story from '@/components/story/Story.astro';
import Text from '@/components/text/Text.astro';
import { SITE_TITLE } from '@/consts';
import { getStories } from '@/utils/stories';
import '@/styles/global.css';
import '@/components/story-list/StoryList.css';
import './index.css';

const recentStories = getStories('desc').slice(0, 4);
const title = `Not found — ${SITE_TITLE}`;
const description = 'That link doesn’t work.';
---

<html lang="en">
  <Head title={title} description={description} type="website" />
  <body>
    <main>
      <h1 class="page-title">Not found</h1>
      <Text>That link doesn’t work. Try one of these recent stories:</Text>
      <ul class="story-list">
        {
          recentStories.map((story) => (
            <Story
              title={story.title}
              href={story.href}
              date={story.publishDate}
              wordCount={story.wordCount}
              readingTime={story.readingTime}
              tags={story.tagLine}
            />
          ))
        }
      </ul>
      <Text>Or, return to the homepage:</Text>
      <PageActions showHomeButton={true} />
    </main>
  </body>
</html>
