---
import Head from '@/components/head/Head.astro';
import PageActions from '@/components/page-actions/PageActions.astro';
import SharePanel from '@/components/share-panel/SharePanel.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import '@/styles/global.css';
import '../index.css';
import './share.css';

const title = `Share — ${SITE_TITLE}`;
const shareUrl = new URL('/', Astro.site).href;
---

<html lang="en">
  <Head title={title} description={SITE_DESCRIPTION} />
  <body>
    <main>
      <article>
        <header>
          <h1 class="page-title">{SITE_TITLE}</h1>
          <h2 class="page-subtitle">Share</h2>
        </header>
        <p class="description">{SITE_DESCRIPTION}</p>
        <SharePanel shareUrl={shareUrl} />
        <PageActions showHomeButton={true} />
      </article>
    </main>
  </body>
</html>
