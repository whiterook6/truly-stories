---
import Head from '@/components/head/Head.astro';
import PageActions from '@/components/page-actions/PageActions.astro';
import Story from '@/components/story/Story.astro';
import StoryList from '@/components/story-list/StoryList.astro';
import StoryListHeader from '@/components/story-list-header/StoryListHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { getAllStoriesDownloadHref, getStories } from '@/utils/stories';
import '@/styles/global.css';
import './index.css';

const [latest, ...olderStories] = getStories('desc');
const downloadHref = getAllStoriesDownloadHref();
---

<html lang="en">
  <Head title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" />
  <body>
    <main>
      <h1 class="page-title">{SITE_TITLE}</h1>
      <h2 class="page-subtitle">by Tim Graboski</h2>
      {
        latest && (
          <StoryList featured labelledBy="latest-story-title">
            <StoryListHeader slot="header">Latest</StoryListHeader>
            <Story
              featured
              titleId="latest-story-title"
              title={latest.title}
              href={latest.href}
              date={latest.publishDate}
              wordCount={latest.wordCount}
              readingTime={latest.readingTime}
              tags={latest.tagLine}
            />
          </StoryList>
        )
      }
      {
        olderStories.length > 0 && (
          <StoryList labelledBy="older-stories-label">
            <StoryListHeader slot="header" id="older-stories-label">
              Older
            </StoryListHeader>
            {olderStories.map((story) => (
              <Story
                title={story.title}
                href={story.href}
                date={story.publishDate}
                wordCount={story.wordCount}
                readingTime={story.readingTime}
                tags={story.tagLine}
              />
            ))}
          </StoryList>
        )
      }
      <PageActions
        downloadHref={downloadHref}
        downloadLabel="Download All"
        shareHref="/share/"
        shareLabel="Share"
      />
    </main>
  </body>
</html>
