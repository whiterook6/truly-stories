---
import Head from '@/components/head/Head.astro';
import ArrowRightIcon from '@/components/icons/ArrowRightIcon.astro';
import PageActions from '@/components/page-actions/PageActions.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { formatDate } from '@/utils/date';
import { getAllStoriesDownloadHref, getStories } from '@/utils/stories';
import '@/styles/global.css';
import './index.css';

const stories = getStories('desc');
const downloadHref = getAllStoriesDownloadHref();
---

<html lang="en">
  <Head title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" />
  <body>
    <main>
      <h1 class="page-title">{SITE_TITLE}</h1>
      <h2 class="page-subtitle">by Tim Graboski</h2>
      <ul class="story-list">
        {
          stories.map((story) => (
            <li class="story-list-item">
              <a class="story-list-link" href={story.href}>
                <span>{story.title}</span>
                <ArrowRightIcon />
              </a>
              <div class="story-list-details">
                <time class="story-list-date" datetime={story.publishDate}>
                  {formatDate(story.publishDate)}
                </time>
                <span class="story-list-sep" aria-hidden="true">·</span>
                <span class="story-list-stats">
                  {story.wordCount.toLocaleString()} words
                </span>
                <span class="story-list-sep" aria-hidden="true">·</span>
                <span class="story-list-stats">{story.readingTime}</span>
              </div>
              {story.tagLine && <p class="story-list-tags">{story.tagLine}</p>}
            </li>
          ))
        }
      </ul>
      <PageActions
        downloadHref={downloadHref}
        downloadLabel="Download"
        shareHref="/share/"
        shareLabel="Share"
      />
    </main>
  </body>
</html>
