---
import Head from '@/components/head/Head.astro';
import ArrowRightIcon from '@/components/icons/ArrowRightIcon.astro';
import PageActions from '@/components/page-actions/PageActions.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { formatDate } from '@/utils/date';
import { getAllStoriesDownloadHref, getStories } from '@/utils/stories';
import '@/styles/global.css';
import './index.css';

const [latest, ...olderStories] = getStories('desc');
const downloadHref = getAllStoriesDownloadHref();
---

<html lang="en">
  <Head title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" />
  <body>
    <main>
      <h1 class="page-title">{SITE_TITLE}</h1>
      <h2 class="page-subtitle">by Tim Graboski</h2>
      {
        latest && (
          <section class="story-featured" aria-labelledby="latest-story-title">
            <p class="group-header">Latest</p>
            <h3 class="story-featured-title" id="latest-story-title">
              <a class="story-list-link" href={latest.href}>
                <span>{latest.title}</span>
                <ArrowRightIcon />
              </a>
            </h3>
            <div class="story-list-details">
              <time class="story-list-date" datetime={latest.publishDate}>
                {formatDate(latest.publishDate)}
              </time>
              <span class="story-list-sep" aria-hidden="true">·</span>
              <span class="story-list-stats">
                {latest.wordCount.toLocaleString()} words
              </span>
              <span class="story-list-sep" aria-hidden="true">·</span>
              <span class="story-list-stats">{latest.readingTime}</span>
            </div>
            {latest.tagLine && (
              <p class="story-list-tags">{latest.tagLine}</p>
            )}
          </section>
        )
      }
      {
        olderStories.length > 0 && (
          <section class="story-older" aria-labelledby="older-stories-label">
            <p class="group-header" id="older-stories-label">Older</p>
            <ul class="story-list">
              {olderStories.map((story) => (
                <li class="story-list-item">
                  <a class="story-list-link" href={story.href}>
                    <span>{story.title}</span>
                    <ArrowRightIcon />
                  </a>
                  <div class="story-list-details">
                    <time class="story-list-date" datetime={story.publishDate}>
                      {formatDate(story.publishDate)}
                    </time>
                    <span class="story-list-sep" aria-hidden="true">·</span>
                    <span class="story-list-stats">
                      {story.wordCount.toLocaleString()} words
                    </span>
                    <span class="story-list-sep" aria-hidden="true">·</span>
                    <span class="story-list-stats">{story.readingTime}</span>
                  </div>
                  {story.tagLine && <p class="story-list-tags">{story.tagLine}</p>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <PageActions
        downloadHref={downloadHref}
        downloadLabel="Download All"
        shareHref="/share/"
        shareLabel="Share"
      />
    </main>
  </body>
</html>
